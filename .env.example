# --- Database (PostgreSQL / Neon) ---
# DATABASE_URL: pooled connection, used by the app at runtime (Neon pooler endpoint
# in production; same as DIRECT_URL for local Docker Postgres, which has no pooler).
DATABASE_URL="postgresql://yoyaku:yoyaku@localhost:5432/yoyaku?schema=public"
# DIRECT_URL: direct (non-pooled) connection, used only by the Prisma CLI
# (migrate/studio/db pull) via prisma.config.ts.
DIRECT_URL="postgresql://yoyaku:yoyaku@localhost:5432/yoyaku?schema=public"

# --- NextAuth ---
NEXTAUTH_SECRET="replace-with-output-of: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# --- Google Calendar / Gmail (two independent salon-wide Google accounts -
# one connected for Calendar, one connected for Gmail sending; same OAuth
# app/client credentials below are shared by both) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/google/oauth/callback"

# AES-256-GCM key used to encrypt the Google refresh token before it is stored in
# GoogleCalendarIntegration.refreshTokenEncrypted. Generate with:
#   openssl rand -base64 32
# In production this must live ONLY in the hosting platform's environment
# variables (e.g. Vercel Environment Variables) - never commit a real value.
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# Set to "true" ONLY in local development and in .env.test. Must NEVER be "true"
# in a production environment - see src/lib/google/calendar/factory.ts /
# src/lib/google/gmail/factory.ts. When unset/false, the real Google service
# implementations are always used, and fail safe (CALENDAR_UNAVAILABLE) if
# Google isn't connected yet, instead of silently booking without a real
# double-booking check.
ALLOW_FAKE_GOOGLE_SERVICES="true"
# Local dev/testing convenience: when ALLOW_FAKE_GOOGLE_SERVICES=true, set this to
# "true" to use the real Google services anyway (e.g. to manually test against a
# real connected account before deploying).
GOOGLE_CALENDAR_ENABLED="false"
