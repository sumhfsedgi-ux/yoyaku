# --- Database (PostgreSQL / Neon) ---
# DATABASE_URL: pooled connection, used by the app at runtime (Neon pooler endpoint
# in production; same as DIRECT_URL for local Docker Postgres, which has no pooler).
DATABASE_URL="postgresql://yoyaku:yoyaku@localhost:5432/yoyaku?schema=public"
# DIRECT_URL: direct (non-pooled) connection, used only by the Prisma CLI
# (migrate/studio/db pull) via prisma.config.ts.
DIRECT_URL="postgresql://yoyaku:yoyaku@localhost:5432/yoyaku?schema=public"

# --- NextAuth ---
NEXTAUTH_SECRET="replace-with-output-of: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# --- Google Calendar / Gmail (two independent salon-wide Google accounts -
# one connected for Calendar, one connected for Gmail sending; same OAuth
# app/client credentials below are shared by both) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/google/oauth/callback"

# AES-256-GCM key used to encrypt the Google refresh token before it is stored in
# GoogleCalendarIntegration.refreshTokenEncrypted. Generate with:
#   openssl rand -base64 32
# In production this must live ONLY in the hosting platform's environment
# variables (e.g. Vercel Environment Variables) - never commit a real value.
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# Set to "true" ONLY in local development and in .env.test. Must NEVER be "true"
# in a production environment - see src/lib/google/calendar/factory.ts /
# src/lib/google/gmail/factory.ts. When unset/false, the real Google service
# implementations are always used, and fail safe (CALENDAR_UNAVAILABLE) if
# Google isn't connected yet, instead of silently booking without a real
# double-booking check.
ALLOW_FAKE_GOOGLE_SERVICES="true"
# Local dev/testing convenience: when ALLOW_FAKE_GOOGLE_SERVICES=true, set this to
# "true" to use the real Google services anyway (e.g. to manually test against a
# real connected account before deploying).
GOOGLE_CALENDAR_ENABLED="false"

# --- Vercel Cron authentication (shared by any Cron-only route, e.g.
# app/api/cron/line-reminders) ---
# Vercel automatically sends "Authorization: Bearer <CRON_SECRET>" on genuine
# Cron-triggered requests when this is set as a project env var. Generate with:
#   openssl rand -base64 32
CRON_SECRET=""

# --- LINE (Messaging API push + LIFF/LINE Login identity - see
# src/lib/line/**) ---
# Phase 1 scope guard (see src/lib/line/staffGate.ts): LINE is enabled for
# exactly ONE staff member - the one whose own Messaging API/LINE Login/LIFF
# setup the values below are configured against (each staff currently
# operates a SEPARATE official LINE account, so a single shared
# LINE_CHANNEL_ACCESS_TOKEN cannot correctly serve more than one). Set this to
# that staff's Staff.id (the internal cuid primary key - never bookingSlug,
# salonName, or email). This value is DIFFERENT per environment (local/
# Preview/Production each have their own database, so the same real staff
# member has a different Staff.id row in each) - it must be set separately in
# each environment's own config, using that environment's own database.
LINE_ENABLED_STAFF_ID=""

# Client-exposed: the bookingSlug of the SAME staff LINE_ENABLED_STAFF_ID
# points at, used only as a routing hint by app/reserve/liff/page.tsx to
# decide whether attempting LIFF login is worth it for the current slug -
# NOT a security boundary (getLineBookingBootstrap always re-verifies
# eligibility server-side via LINE_ENABLED_STAFF_ID regardless of this
# value). Not a secret - bookingSlug is already exposed in the plain booking
# URL. If unset, every slug falls back to the plain /reserve/[slug] page.
# Keep in sync with LINE_ENABLED_STAFF_ID's target staff; if they drift, the
# worst case is an unnecessary LIFF login attempt that Bootstrap safely
# rejects, never a data leak (see .claude/plans).
NEXT_PUBLIC_LINE_ENABLED_BOOKING_SLUG=""

# Server-only secret: the Messaging API channel's long-lived Channel Access
# Token, used to send confirmation/reminder pushes. NEVER prefix with
# NEXT_PUBLIC_.
LINE_CHANNEL_ACCESS_TOKEN=""

# Server-only: the LINE Login Channel ID, used as the `client_id` parameter
# when verifying a LIFF ID Token against LINE's own verify endpoint (see
# lib/line/identity.ts). The client only ever needs NEXT_PUBLIC_LIFF_ID below
# to call liff.init() - this value is never sent to the browser.
LINE_LOGIN_CHANNEL_ID=""

# Client-exposed: the LIFF app ID, passed to liff.init() from
# app/reserve/liff/page.tsx. Not a secret - LINE's own LIFF docs treat this as
# safe to embed in front-end code.
NEXT_PUBLIC_LIFF_ID=""

# One of "off" | "test" | "production" - see src/lib/reservations/lineNotifications.ts
# and src/lib/line/messaging/real.ts. Must be "off" until LINE Developers setup
# is confirmed, then "test" (pushes ONLY ever reach LINE_TEST_USER_ID, enforced
# server-side, never by a UI toggle) before finally switching to "production".
LINE_NOTIFICATION_MODE="off"

# Your own LINE userId, verified via LIFF once during setup - see plan's
# Preview/Production rollout steps. The ONLY recipient LINE pushes may ever
# reach while LINE_NOTIFICATION_MODE="test".
LINE_TEST_USER_ID=""

# Server-only: comma-separated LINE user IDs that receive new booking
# notifications for LINE_ENABLED_STAFF_ID (see src/lib/line/
# staffRecipients.ts and src/lib/reservations/lineNotifications.ts's
# STAFF_NEW_RESERVATION type). Independent of LINE_TEST_USER_ID - these
# recipients are always reachable (even while LINE_NOTIFICATION_MODE="test"),
# since they are an explicit, small, server-configured allowlist, not
# customer-facing sends. Do NOT prefix with NEXT_PUBLIC_. These userIds MUST
# be issued by the SAME LINE Provider as the Messaging API Channel that sends
# them (LINE_CHANNEL_ACCESS_TOKEN above, "腸もみサロン ゆきの"'s own official
# LINE account) - a userId issued under a different Provider/channel cannot
# receive a push here. Manual test precondition: every recipient listed here
# must have added that same official LINE account as a friend before a push
# can reach them.
LINE_STAFF_NOTIFICATION_USER_IDS=""

# Set to "true" ONLY in local development and in .env.test. Must NEVER be
# "true" in a production environment - mirrors ALLOW_FAKE_GOOGLE_SERVICES
# above (see src/lib/line/messaging/factory.ts). When unset/false, the real
# LINE Messaging service is always used (still gated by LINE_NOTIFICATION_MODE
# above regardless).
ALLOW_FAKE_LINE_SERVICES="true"
